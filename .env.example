# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.

# Telegram : bot créé avec @BotFather, et l'identifiant du chat du propriétaire
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Portefeuille Polygon dédié au bot (clé privée, avec ou sans 0x)
PRIVATE_KEY=
# Adresse du portefeuille de dépôt Polymarket (ordres V2)
DEPOSIT_WALLET=

# Clé de chiffrement locale, à générer :
# python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# RPC Polygon (optionnel)
ALCHEMY_API_KEY=

# Proxy (optionnel), par exemple socks5://127.0.0.1:1080
PROXY_URL=
